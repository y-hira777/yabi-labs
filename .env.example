# ==================================================
# Yabi Labs — 環境変数テンプレート
# このファイルをコピーして .env.local を作成してください
# .env.local は Git 管理されません（.gitignore で除外済み）
# ==================================================

# --------------------------------------------------
# microCMS
# https://app.microcms.io でプロジェクトを作成後に取得
# --------------------------------------------------

# サービスドメイン（xxxx.microcms.io の xxxx 部分）
MICROCMS_SERVICE_DOMAIN=your-service-domain

# APIキー（microCMS 管理画面 > API設定 > APIキー）
MICROCMS_API_KEY=your-api-key

# APIエンドポイント名（microCMS 管理画面で作成したAPI名）
MICROCMS_ENDPOINT_ARTICLES=articles
MICROCMS_ENDPOINT_CATEGORIES=categories
MICROCMS_ENDPOINT_TAGS=tags

# --------------------------------------------------
# サイト情報（NEXT_PUBLIC_ = クライアントサイドでも使用可）
# --------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://yabi-labs.jp
NEXT_PUBLIC_SITE_NAME=Yabi Labs
NEXT_PUBLIC_SITE_DESCRIPTION=AI・Web制作・デザイン・自動化の実験室

# --------------------------------------------------
# 開発環境での上書き例（本番は Netlify の環境変数で設定）
# --------------------------------------------------
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
